<?xml version="1.0" encoding="utf-8"?>
<!--
  Trusted Web Activity wrapper for the FalsafahTot web app.

  Why this manifest is so small: a TWA hands rendering entirely to Chrome (the same Chrome
  already on the device), so camera/microphone/geolocation/notifications/downloads are all
  Chrome's own permissions and Chrome's own runtime prompts — exactly as if the person had
  opened the site in a regular browser tab. This app never touches the camera, microphone,
  location, or notification APIs itself, so it doesn't declare CAMERA/RECORD_AUDIO/
  ACCESS_FINE_LOCATION/POST_NOTIFICATIONS permissions here — declaring them would do nothing
  (Chrome ignores permissions declared by the app that launched it) and would only confuse
  Play Store's permissions review. See android/README.md "How permissions actually work" for
  the full explanation.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.App"
        android:manageSpaceActivity="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
        tools:targetApi="31">

        <!-- "Clear app data" in system Settings opens the web app so the user can sign out /
             clear their own data there, rather than only wiping the (mostly empty) local
             Android app storage. -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
            android:exported="false">
            <meta-data
                android:name="android.support.customtabs.trusted.MANAGE_SPACE_URL"
                android:value="@string/launch_url" />
        </activity>

        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:label="@string/app_name"
            android:theme="@style/Theme.App"
            android:exported="true">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/launch_url" />

            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/brand_green" />

            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/brand_cream" />

            <!-- Splash screen: brand-green background + the app's logo mark, shown for the brief
                 moment between tapping the launcher icon and the site's own content appearing. -->
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@drawable/ic_launcher_foreground" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/brand_green" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_FADE_OUT_DURATION"
                android:value="300" />

            <!-- Lets Chrome hand a camera-captured photo back to the page's <input type="file">
                 via a content:// URI (see the FileProvider below and res/xml/filepaths.xml). -->
            <meta-data
                android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY"
                android:value="${applicationId}.fileprovider" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- autoVerify: Android checks https://<host_name>/.well-known/assetlinks.json at
                 install time and only opens this app full-screen (no browser chrome) once that
                 file's sha256_cert_fingerprints matches this build's signing certificate — see
                 android/README.md "Digital Asset Links verification". Until that's set up, the
                 app still works, just shows Chrome's normal address bar. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="@string/host_name" />
            </intent-filter>
        </activity>

        <!-- Required by the library for a handful of internal TWA/Custom Tabs flows (e.g.
             returning focus to the right window after a permission prompt). No configuration
             needed. -->
        <activity android:name="com.google.androidbrowserhelper.trusted.FocusActivity" />

        <!-- Lets a captured camera photo (or a file picked from storage) be handed to Chrome as
             a content:// URI instead of a raw file path, per Android's scoped-storage rules. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!-- Notification delegation: when the web app calls the Notifications API, Chrome shows
             the notification but hands it to this service first so it displays with the app's
             own name/icon/notification channel instead of Chrome's. Requires the user to have
             granted the site notification permission in Chrome — same as any website. -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

    </application>
</manifest>
