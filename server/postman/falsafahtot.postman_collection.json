          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign In - request OTP (buyer)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('has pendingToken', () => pm.expect(body.pendingToken).to.be.a('string'));",
            "pm.environment.set('pendingToken', body.pendingToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{buyerIdentifier}}\",\n  \"password\": \"{{demoPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/auth/signin", "host": ["{{baseUrl}}"], "path": ["api", "auth", "signin"] }
          }
        },
        {
          "name": "Verify OTP - Sign In (buyer)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('has token', () => pm.expect(body.token).to.be.a('string'));",
            "pm.environment.set('buyerToken', body.token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pendingToken\": \"{{pendingToken}}\",\n  \"code\": \"{{otp}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/auth/otp/verify", "host": ["{{baseUrl}}"], "path": ["api", "auth", "otp", "verify"] }
          }
