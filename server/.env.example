# Comma-separated list of exact origins allowed in production (e.g. https://falsafahtot.com,
# https://www.falsafahtot.com). In development, any localhost/private-LAN origin on any port is
# also accepted automatically — see isPrivateLanOrigin() in src/app.js — so you don't need to
# edit this per Vite port or per network; it only matters for production.
CLIENT_ORIGIN=http://localhost:5173
