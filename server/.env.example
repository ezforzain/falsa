PORT=5000
MONGODB_URI=mongodb://localhost:27017/falsafahtot
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d
# Exact origin allowed in production. In development, LAN origins on port 5173 (a phone/other
# device reaching the Vite dev server's QR-coded network URL) are also accepted automatically
# — see isPrivateLanOrigin() in src/app.js — so you don't need to edit this per network.
CLIENT_ORIGIN=http://localhost:5173
