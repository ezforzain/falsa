MONGODB_URI=mongodb://localhost:27017/falsafahtot
JWT_SECRET=change_me
CLIENT_ORIGIN=http://localhost:5173

# Email verification — sign up at resend.com, verify a sending domain (or use their shared
# onboarding@resend.dev sender to start), then paste the API key here. Without this,
# accounts still sign up fine but the verification email silently fails to send (signup
# response comes back with emailSendFailed: true) — use "Resend email" once configured.
RESEND_API_KEY=your_resend_api_key_here
# Must be on a domain you've verified in Resend once you move off their shared test sender.
EMAIL_FROM=Falsafah <onboarding@resend.dev>

# Claude / Anthropic integration (optional)
# Set these to enable the server-side Claude proxy route at POST /api/claude/generate
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_API_URL=https://api.anthropic.com/v1/complete
PORT=5000
MONGODB_URI=mongodb://localhost:27017/falsafahtot
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d
# Comma-separated list of exact origins allowed in production (e.g. https://falsafahtot.com,
# https://www.falsafahtot.com). In development, any localhost/private-LAN origin on any port is
# also accepted automatically — see isPrivateLanOrigin() in src/app.js — so you don't need to
# edit this per Vite port or per network; it only matters for production.
CLIENT_ORIGIN=http://localhost:5173
